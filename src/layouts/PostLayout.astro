---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  subtitle?: string;
}

const { title, description, date, tags = [], subtitle } = Astro.props;
---

<BaseLayout title={`${title} | ysmiles`} description={description} pageType="article">
  <article class="article-shell content-shell">
    <header class="article-header">
      <p class="eyebrow">Post</p>
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="page-intro">{subtitle}</p>}
      <div class="meta article-meta">
        <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
      </div>
      <TagList tags={tags} />
    </header>
    <div class="article-body prose">
      <slot />
    </div>
  </article>
</BaseLayout>
