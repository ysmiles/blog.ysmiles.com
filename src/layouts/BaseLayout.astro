---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  pageType?: "website" | "article";
}

const {
  title,
  description = "Personal writing on software, life, and other interests.",
  image = "/images/site-bg.jpg",
  pageType = "website",
} = Astro.props;
const siteName = "ysmiles";
const canonicalUrl = Astro.url.href;
const baseUrl = Astro.site ?? Astro.url;
const socialImage = new URL(image, baseUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#8c3b2a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS feed`} href="/rss.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <Header />
    <main class="site-shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
