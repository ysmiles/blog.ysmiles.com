---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);
---

<BaseLayout title="ysmiles" description="Personal writing on software, life, music, and other interests.">
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">Notes on software, life, and making things</p>
      <h1>ysmiles</h1>
      <p>
        A rebuilt personal blog in progress. This Astro migration keeps the existing writing while simplifying the
        source workflow into one repository.
      </p>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Now</p>
      <p class="hero__panel-text">
        The site is now Astro-based, source-first, and easier to keep alive. Visual polish is still evolving, but the
        writing is back in one place.
      </p>
    </aside>
  </section>

  <section class="section-heading">
    <p class="eyebrow">Recent writing</p>
    <h2>Latest posts</h2>
  </section>

  <section class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
